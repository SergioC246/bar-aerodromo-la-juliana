NODE_ENV=development
PORT=5000

# Database
# In production (Render) DATABASE_URL is used. For local development use the DB_* variables.
# DATABASE_URL=postgres://user:password@host:5432/database_name
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bar_aerodrome
DB_USER=postgres
DB_PASSWORD=your_password

# CORS
CORS_ORIGIN=http://localhost:8000

# Security - Generate strong random secrets!
# For production: use `openssl rand -base64 32`
JWT_SECRET=your_jwt_secret_change_me_in_production
ADMIN_SECRET=your_admin_secret_change_me_in_production

# Staff access (kitchen and bar): shared password.
# If not set, staff access is disabled.
STAFF_PASSWORD=your_staff_password_change_me

# Web Push (notifies the customer when their order is ready)
# Generate your own with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:contact@baraerodromolajuliana.com
